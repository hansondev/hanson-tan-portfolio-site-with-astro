  '09': Array.from({ length: 5 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-ai-rag-system-with-whatsapp-bot-automation/n8n-ai-rag-system-with-whatsapp-bot-automation_image-${String(i + 1).padStart(2, '0')}.jpeg`),
  '10': Array.from({ length: 6 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-ai-full-seo-blog-post-gen/n8n-ai-full-seo-blog-post-gen_image-${String(i + 1).padStart(2, '0')}.jpeg`),
  '11': Array.from({ length: 7 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-ai-full-google-ads-keywords-and-ad-copies-gen/n8n-ai-full-google-ads-keywords-and-ad-copies-gen_image-${String(i + 1).padStart(2, '0')}.jpeg`),
  '12': Array.from({ length: 7 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-ai-full-google-ads-keywords-and-ad-copies-gen/n8n-ai-full-google-ads-keywords-and-ad-copies-gen_image-${String(i + 1).padStart(2, '0')}.jpeg`),
