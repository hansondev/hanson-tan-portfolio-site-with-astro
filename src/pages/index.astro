    '/images/performance-mkt-case-studies/home-hacking-service-sem-google-ads/home-hacking-service-sem-google-ads-2.jpg',
    '/images/performance-mkt-case-studies/home-hacking-service-sem-google-ads/home-hacking-service-sem-google-ads-3.jpg',
    '/images/performance-mkt-case-studies/home-hacking-service-sem-google-ads/home-hacking-service-sem-google-ads-result.jpg',
  ],
  'edu-multi': [
