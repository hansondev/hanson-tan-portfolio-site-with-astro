  '04': Array.from({ length: 2 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-social-media-ads-copies-gen-automation/social-media-ads-copies-gen_image-${String(i + 1).padStart(2, '0')}.jpeg`),
  '05': Array.from({ length: 3 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-ai-google-slides-ads-report-gen/n8n-ai-google-slides-ads-report-gen_image-${String(i + 1).padStart(2, '0')}.jpeg`),
  '07': Array.from({ length: 2 }, (_, i) => `/images/ai-powered-marketing-use-cases/n8n-ai-landing-page-content-to-strapi-cms/n8n-ai-landing-page-content-to-strapi-cms_image-${String(i + 1).padStart(2, '0')}.jpeg`),
