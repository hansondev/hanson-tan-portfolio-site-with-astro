    '/images/performance-mkt-case-studies/education-academy-sem-gads-fb-ads/education-academy-sem-gads-fb-ads-2.jpg',
    '/images/performance-mkt-case-studies/education-academy-sem-gads-fb-ads/education-academy-sem-gads-fb-ads-results.jpg',
  ],
  'hospital-2': [
    '/images/performance-mkt-case-studies/hospital-service-fb-ads-case-study-2/hospital-service-fb-ads-case-study-2-dashboard.jpg',
