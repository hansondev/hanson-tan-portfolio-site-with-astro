---
/* eslint-disable react/jsx-key */
import Layout from '@/layouts/BaseLayout.astro';
import portfolioContent from '../../portfolio-content-versioning/2026-08-05-portfolio-content.json';

const { meta, hero, stats, about } = portfolioContent;
const {
  ai_automation_use_cases: projectSection,
  career_experiences: careerSection,
  core_capabilities: capabilitiesSection,
  dm_case_studies: caseStudySection,
  how_i_work: processSection,
  key_achievements: achievementsSection,
} = portfolioContent.core;

const aboutParagraphs = about.about_description.split('\n\n');

const projectFilterByCategoryKey: Record<string, string> = {
  'ads-campaign-ai-automation': 'data-ai',
  'agent-ai-report-generation': 'data-ai',
  'agentic-ui-generation': 'agent-infra',
  'ai-agent-content-generation': 'content-ai',
  'ai-agentic-chatbot': 'agent-infra',
  'ai-coding-agent': 'web-dev',
  'ai-retrieval-augmented-generation': 'data-ai',
  'content-automation': 'content-ai',
};

const projects = projectSection.ai_automation_use_cases_cards.map((project, index) => ({
  id: portfolioContent.projects[index]?.id ?? String(index + 1).padStart(2, '0'),
  category: project.use_case_category,
  filter: projectFilterByCategoryKey[project.category_key] ?? '',
  title: project.use_case,
  problem: project.problem,
  solution: project.solution,
  impact: project.impact,
  tech_stack: project.tech_stack_text.split(',').map((tech) => tech.trim()).filter(Boolean),
}));

const process = processSection.how_i_work_cards.map((step) => ({
  step: step.phase_index,
  title: step.phase_name,
  description: step.phase_description,
}));

const career = careerSection.career_experiences_cards.map((job) => ({
  company: job.organization_name,
  role: job.career_title,
  period: job.career_duration,
  bullets: job.bullets,
}));

const caseStudies = caseStudySection.dm_case_studies_cards.map((caseStudy, index) => ({
  ...caseStudy,
  subtitle: portfolioContent.case_studies[index]?.subtitle ?? caseStudy.ad_platforms.join(' + '),
}));

const projectImages: Record<string, string[]> = {
