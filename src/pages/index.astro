---
/* eslint-disable react/jsx-key */
import Layout from '@/layouts/BaseLayout.astro';
import portfolioContent from '../../portfolio-content-versioning/2026-08-14-portfolio-content.json';

type PortfolioCore = typeof portfolioContent.core & {
  ai_web_dev_projects: {
    ai_web_dev_projects_headline: string;
    ai_web_dev_projects_subheadline: string;
    ai_web_dev_projects_description: string;
    ai_web_dev_projects_cards: UseCaseCard[];
  };
  ai_performance_marketing_use_cases: {
    ai_performance_marketing_use_cases_headline: string;
    ai_performance_marketing_use_cases_subheadline: string;
    ai_performance_marketing_use_cases_description: string;
    ai_performance_marketing_use_cases_cards: UseCaseCard[];
  };
  ai_seo_use_cases: {
    ai_seo_use_cases_headline: string;
    ai_seo_use_cases_subheadline: string;
    ai_seo_use_cases_description: string;
    ai_seo_use_cases_cards: UseCaseCard[];
  };
};

const { meta, hero, stats, about, contact } = portfolioContent;
const portfolioCore = portfolioContent.core as PortfolioCore;
const {
  ai_automation_use_cases: projectSection,
  ai_performance_marketing_use_cases: performanceMarketingSection,
  ai_seo_use_cases: seoSection,
  ai_web_dev_projects: webDevSection,
  career_experiences: careerSection,
  core_capabilities: capabilitiesSection,
  dm_case_studies: caseStudySection,
  how_i_work: processSection,
} = portfolioCore;

const aboutParagraphs = about.about_description.split('\n\n');

type PortfolioMediaItem = {
  imageUrl: string;
  altText: string;
};

type PortfolioVideoItem = {
  videoUrl: string;
};

type PortfolioProject = {
  id: string;
  displayId: string;
  category: string;
  filter: string;
  title: string;
  problem: string;
  solution: string;
  impact: string;
  tech_stack: string[];
  images: PortfolioMediaItem[];
  videos: PortfolioVideoItem[];
};

type PortfolioCaseStudy = {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  business_model: string;
  ad_platforms: string[];
  images: PortfolioMediaItem[];
  videos: PortfolioVideoItem[];
};

type UseCaseCard = {
  use_case?: string;
  use_case_category?: string;
  category_key?: string;
  problem?: string;
  solution?: string;
  impact?: string;
  tech_stack_text?: string;
  tech_stack?: string[];
  images?: PortfolioMediaItem[];
  videos?: PortfolioVideoItem[];
};

const normalizeText = (value: string) => value.replace(/\r/g, '').trim().toLowerCase();

const projectFilterByCategoryKey: Record<string, string> = {
  'ads-campaign-ai-automation': 'data-ai',
  'ai-agent-ads-campaign-optimization': 'data-ai',
  'ai-agent-competitor-analysis': 'data-ai',
  'agent-ai-report-generation': 'data-ai',
  'ai-agent-report-generation': 'data-ai',
  'ai-agent-search-engine-optimization': 'data-ai',
  'agentic-ui-generation': 'agent-infra',
  'ai-agent-content-generation': 'content-ai',
  'ai-agentic-chatbot': 'agent-infra',
  'ai-coding-agent': 'web-dev',
  'ai-retrieval-augmented-generation': 'data-ai',
  'content-automation': 'content-ai',
};

const projectMediaByTitle = new Map(
  portfolioContent.projects.map((project) => [normalizeText(project.title), project]),
);

const toProjectCards = (cards: UseCaseCard[], groupKey: string): PortfolioProject[] => cards.map((project, index) => {
  const title = project.use_case ?? '';
  const media = projectMediaByTitle.get(normalizeText(title));
  const displayId = String(index + 1).padStart(2, '0');
  const techStack = project.tech_stack_text
    ? project.tech_stack_text.split(',').map((tech) => tech.trim()).filter(Boolean)
    : project.tech_stack ?? [];

  return {
    id: `${groupKey}-${displayId}`,
    displayId,
    category: project.use_case_category ?? '',
    filter: projectFilterByCategoryKey[project.category_key ?? ''] ?? '',
    title,
    problem: project.problem ?? '',
    solution: project.solution ?? '',
    impact: project.impact ?? '',
    tech_stack: techStack,
    images: project.images ?? media?.images ?? [],
    videos: project.videos ?? media?.videos ?? [],
  };
});

const projects = toProjectCards(projectSection.ai_automation_use_cases_cards, 'automation');
const webDevProjects = toProjectCards(webDevSection.ai_web_dev_projects_cards, 'web-dev');
const performanceMarketingProjects = toProjectCards(
  performanceMarketingSection.ai_performance_marketing_use_cases_cards,
  'performance',
);
const seoProjects = toProjectCards(seoSection.ai_seo_use_cases_cards, 'seo');

const projectFilters = [
  {
    label: 'All Projects',
    value: 'all',
    className: 'rounded-full bg-sky text-midnight px-4 py-2 text-sm font-semibold cursor-pointer border-0',
  },
  {
    label: 'Content & Creative AI',
    value: 'content-ai',
    className: 'rounded-full border border-[var(--border-color)] px-4 py-2 text-sm text-[var(--muted-color)] cursor-pointer bg-transparent hover:text-sky hover:border-sky transition-colors',
  },
  {
    label: 'Data & Paid Media AI',
    value: 'data-ai',
    className: 'rounded-full border border-[var(--border-color)] px-4 py-2 text-sm text-[var(--muted-color)] cursor-pointer bg-transparent hover:text-sky hover:border-sky transition-colors',
  },
  {
    label: 'Agent Infrastructure',
    value: 'agent-infra',
    className: 'rounded-full border border-[var(--border-color)] px-4 py-2 text-sm text-[var(--muted-color)] cursor-pointer bg-transparent hover:text-sky hover:border-sky transition-colors',
  },
  {
    label: 'Web Development',
    value: 'web-dev',
    className: 'rounded-full border border-[var(--border-color)] px-4 py-2 text-sm text-[var(--muted-color)] cursor-pointer bg-transparent hover:text-sky hover:border-sky transition-colors',
  },
];

const projectGroups = [
  {
    id: 'projects',
    headline: projectSection.ai_automation_use_cases_headline,
    subheadline: projectSection.ai_automation_use_cases_subheadline,
    description: projectSection.ai_automation_use_cases_description,
    cards: projects,
    filters: projectFilters,
  },
  {
    id: 'ai-web-dev-projects',
    headline: webDevSection.ai_web_dev_projects_headline,
    subheadline: webDevSection.ai_web_dev_projects_subheadline,
    description: webDevSection.ai_web_dev_projects_description,
    cards: webDevProjects,
    filters: [],
  },
  {
    id: 'ai-performance-marketing-use-cases',
    headline: performanceMarketingSection.ai_performance_marketing_use_cases_headline,
    subheadline: performanceMarketingSection.ai_performance_marketing_use_cases_subheadline,
    description: performanceMarketingSection.ai_performance_marketing_use_cases_description,
    cards: performanceMarketingProjects,
    filters: [],
  },
  {
    id: 'ai-seo-use-cases',
    headline: seoSection.ai_seo_use_cases_headline,
    subheadline: seoSection.ai_seo_use_cases_subheadline,
    description: seoSection.ai_seo_use_cases_description,
    cards: seoProjects,
    filters: [],
  },
];

const allProjectCards = projectGroups.flatMap((group) => group.cards);

const process = processSection.how_i_work_cards.map((step) => ({
  step: step.phase_index,
  title: step.phase_name,
  description: step.phase_description,
}));

const career = careerSection.career_experiences_cards.map((job) => ({
  company: job.organization_name,
  role: job.career_title,
  period: job.career_duration,
  bullets: job.bullets,
}));

const caseStudies = portfolioContent.case_studies.map((caseStudy, index) => ({
  id: `case-study-${String(index + 1).padStart(2, '0')}`,
  title: caseStudy.title,
  subtitle: caseStudy.subtitle,
  description: caseStudy.description,
  business_model: caseStudy.business_model,
  ad_platforms: caseStudy.ad_platforms,
  images: caseStudy.images ?? [],
  videos: [],
}));

const allGalleries: Record<string, string[]> = Object.fromEntries(
  [
    ...allProjectCards,
    ...caseStudies,
  ]
    .filter((item) => item.images.length > 0)
    .map((item) => [item.id, item.images.map((image) => image.imageUrl)]),
);

const galleriesJson = JSON.stringify(allGalleries);
---

<Layout
  metadata={{
    title: meta.meta_title,
    description: meta.meta_description,
    openGraph: {
      title: meta.meta_title,
      description: meta.meta_description,
      url: 'https://portfolio.hansondev.me',
      type: 'website',
    },
  }}
>
  <div id="gallery-data" data-json={galleriesJson} hidden></div>
  <div
    id="video-data"
    data-json={JSON.stringify(Object.fromEntries([...allProjectCards, ...caseStudies].filter((item) => item.videos.length > 0).map((item) => [item.id, item.videos[0].videoUrl])))}
    hidden
  ></div>
  <script is:inline>
    window.__galleries = JSON.parse(document.getElementById('gallery-data').dataset.json);
    window.__videos = JSON.parse(document.getElementById('video-data').dataset.json);
    window.__currentGalleryId = '';
    window.__currentIndex = 0;
    window.__currentVideoId = '';

    function openLightbox(galleryId, index) {
      window.__currentGalleryId = galleryId;
      window.__currentIndex = index;
      updateLightboxImage();
      document.getElementById('gallery-dialog').showModal();
    }

    function updateLightboxImage() {
      const imgs = window.__galleries[window.__currentGalleryId];
      if (!imgs) return;
      const imgEl = document.getElementById('lightbox-img');
      if (imgEl) imgEl.src = imgs[window.__currentIndex];
      const counter = document.getElementById('lightbox-counter');
      if (counter) counter.textContent = (window.__currentIndex + 1) + ' / ' + imgs.length;
    }

    function prevImage() {
      const imgs = window.__galleries[window.__currentGalleryId];
      if (!imgs) return;
      window.__currentIndex = (window.__currentIndex - 1 + imgs.length) % imgs.length;
      updateLightboxImage();
    }

    function nextImage() {
      const imgs = window.__galleries[window.__currentGalleryId];
      if (!imgs) return;
      window.__currentIndex = (window.__currentIndex + 1) % imgs.length;
      updateLightboxImage();
    }

    function openVideoModal(videoId) {
      window.__currentVideoId = videoId;
      const dialog = document.getElementById('video-dialog');
      const video = document.getElementById('portfolio-video');
      const source = window.__videos[videoId];
      if (!dialog || !video || !source) return;

      video.src = source;
      dialog.showModal();
    }

    function closeVideoModal() {
      const dialog = document.getElementById('video-dialog');
      const video = document.getElementById('portfolio-video');
      if (video) {
        video.pause();
        video.removeAttribute('src');
        video.load();
      }
      if (dialog?.open) dialog.close();
    }

    window.openVideoModal = openVideoModal;
    window.closeVideoModal = closeVideoModal;
  </script>

  <!-- Hero Section -->
  <section id="hero" class="py-10 sm:py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-col gap-6 items-center text-center">
        <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl">
          {hero.hero_tagline}
        </h2>
        <p class="font-heading text-foreground font-semibold text-4xl md:text-5xl lg:text-[38px] leading-tight max-w-3xl">
          {hero.hero_headline}
        </p>
        <p class="text-base max-w-2xl text-[var(--muted-color)] leading-relaxed">
          {hero.hero_description}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mt-4">
          <a href="#projects" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-semibold h-10 px-4 py-2 bg-sky text-midnight hover:bg-sky/90 transition-colors">
            View Projects
          </a>
          <a href="#contact" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium h-10 px-4 py-2 border border-navy-border text-light-text hover:text-sky hover:border-sky transition-colors">
            Let's Talk
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section id="stats" class="py-10 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {stats.map((stat) => (
          <div class="flex flex-col items-center rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-4 sm:p-6 text-center">
            <span class="text-4xl font-bold tracking-tight text-sky md:text-5xl">{stat.value}</span>
            <span class="mt-2 text-base font-medium text-[var(--foreground-color)]">{stat.label}</span>
            <span class="mt-1 text-sm text-[var(--muted-color)]">{stat.context}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-10 md:py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">{about.about_subheadline}</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">{about.about_headline}</p>
      <div class="flex justify-center mt-8">
        <img
          src="/images/personal-image/hanson-tan-profile-photo.jpg"
          alt="Hanson Tan — Professional Portrait"
          class="w-40 h-40 rounded-full object-cover border-2 border-[var(--border-color)] shadow-lg"
          loading="lazy"
        />
      </div>
      <div class="mt-8 space-y-4 text-base leading-relaxed text-[var(--foreground-color)]">
        {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="flex flex-wrap gap-2 justify-center mt-6">
        <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-sm text-[var(--muted-color)]">B2B SaaS</span>
        <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-sm text-[var(--muted-color)]">Healthcare & Wellness</span>
        <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-sm text-[var(--muted-color)]">E-commerce Growth</span>
        <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-sm text-[var(--muted-color)]">Fintech & EdTech</span>
        <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-sm text-[var(--muted-color)]">AI Agent Infrastructure</span>
        <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-sm text-[var(--muted-color)]">Marketing Automation</span>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="py-10 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">Capabilities</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">
        {capabilitiesSection.core_capabilities_headline}
      </p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {capabilitiesSection.core_capabilities_cards.map((capability) => (
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-4 sm:p-6 flex flex-col gap-4">
            <div>
              <h3 class="text-xl font-semibold text-[var(--foreground-color)]">{capability.title}</h3>
              {capability.description && <p class="mt-2 text-sm leading-relaxed text-[var(--muted-color)]">{capability.description}</p>}
            </div>
            <div class="flex flex-wrap gap-2">
              {capability.skill_categories.map((category) => (
                <span class="rounded-full bg-sky/10 px-3 py-1 text-xs font-medium text-sky">{category}</span>
              ))}
            </div>
            <div class="flex flex-wrap gap-2 pt-3 border-t border-[var(--border-color)]">
              {capability.tech_stacks_using.map((tech) => (
                <span class="rounded-full border border-[var(--border-color)] px-3 py-1 text-xs text-[var(--muted-color)]">{tech}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  {projectGroups.map((group) => (
    <section id={group.id} class="py-10 md:py-16">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">{group.headline}</h2>
        <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">{group.subheadline}</p>
        <p class="text-center text-[var(--muted-color)] mt-4 max-w-2xl mx-auto">
          {group.description}
        </p>

        {group.filters.length > 0 && (
          <div class="flex justify-center gap-2 sm:gap-4 mt-8 flex-wrap" id="project-tabs">
            {group.filters.map((filter) => (
              <button type="button" class={filter.className} data-filter={filter.value}>{filter.label}</button>
            ))}
          </div>
        )}

        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {group.cards.map((project) => (
            <div class="rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-4 sm:p-6 flex flex-col gap-3" data-filter={project.filter}>
              {project.images.length > 0 && (
                <button
                  type="button"
                  class="w-full cursor-pointer border-0 bg-transparent p-0 -mt-2 sm:-mt-3 -mx-2 sm:-mx-3"
                  onclick={`openLightbox('${project.id}', 0)`}
                  aria-label={`View ${project.images.length} gallery images for ${project.title}`}
                >
                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-0.5 rounded-t-lg overflow-hidden h-28">
                    {project.images.slice(0, 3).map((img: PortfolioMediaItem, i: number) => (
                      <img
                        src={img.imageUrl}
                        alt={img.altText || `${project.title} screenshot ${i + 1}`}
                        class="w-full h-28 object-cover"
                        loading="lazy"
                      />
                    ))}
                  </div>
                  <div class="relative -mt-6 bg-gradient-to-t from-black/60 to-transparent h-6 rounded-b-lg flex items-end justify-center">
                    <span class="text-white text-xs font-medium pb-0.5">View {project.images.length} images</span>
                  </div>
                </button>
              )}
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-sky uppercase">#{project.displayId}</span>
                <span class="rounded-full border border-[var(--border-color)] px-2 py-0.5 text-xs text-[var(--muted-color)]">{project.category}</span>
              </div>
              <h3 class="text-lg font-semibold text-[var(--foreground-color)]">{project.title}</h3>
              <p class="text-sm text-[var(--muted-color)] leading-relaxed">
                <strong class="text-[var(--foreground-color)]">Problem:</strong> {project.problem}
              </p>
              <p class="text-sm text-[var(--muted-color)] leading-relaxed">
                <strong class="text-[var(--foreground-color)]">Solution:</strong> {project.solution}
              </p>
              <p class="text-sm text-sky font-medium">Impact: {project.impact}</p>
              <div class="flex flex-wrap gap-1 mt-auto pt-3 border-t border-[var(--border-color)]">
                {project.tech_stack.map((tech) => (
                  <span class="rounded-full border border-[var(--border-color)] px-2 py-0.5 text-xs text-[var(--muted-color)]">{tech}</span>
                ))}
              </div>
              {project.videos.length > 0 && (
                <button
                  type="button"
                  class="mt-3 inline-flex items-center justify-center rounded-md border border-sky px-3 py-2 text-sm font-semibold text-sky transition-colors hover:bg-sky hover:text-midnight"
                  onclick={`openVideoModal('${project.id}')`}
                  aria-label={`Watch video for ${project.title}`}
                >
                  Watch Video
                </button>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Process Section -->
  <section id="process" class="py-10 md:py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">{processSection.how_i_work_headline}</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">{processSection.how_i_work_subheadline}</p>
      <ol class="mt-8 flex flex-col gap-8">
        {process.map((step) => (
          <li class="relative pl-16">
            <span class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full bg-sky text-midnight text-lg font-bold" aria-hidden="true">{step.step}</span>
            <h3 class="text-xl font-semibold text-[var(--foreground-color)]">{step.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-[var(--muted-color)]">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Career Section -->
  <section id="career" class="py-10 md:py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">Career</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">{careerSection.career_experiences_headline}</p>
      <p class="text-center text-[var(--muted-color)] mt-2">{careerSection.career_experiences_description}</p>
      <div class="mt-8 space-y-4 sm:space-y-8">
        {career.map((job) => (
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-4 sm:p-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
              <h3 class="text-lg font-semibold text-[var(--foreground-color)]">{job.company}</h3>
              <span class="text-sm text-[var(--muted-color)]">{job.period}</span>
            </div>
            <p class="text-sky font-medium">{job.role}</p>
            <ul class="mt-3 space-y-1">
              {job.bullets.map((b: string) => (
                <li class="text-sm text-[var(--muted-color)] flex gap-2"><span class="text-sky">•</span> {b}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results / Case Studies Section -->
  <section id="results" class="py-10 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">Proven Results</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">Key Achievements</p>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {portfolioContent.results.map((result) => (
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-4 sm:p-6">
            <span class="text-4xl font-bold tracking-tight text-sky">{result.metric}</span>
            <h3 class="mt-3 text-lg font-semibold leading-snug text-[var(--foreground-color)]">{result.label}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--muted-color)]">{result.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Studies Gallery Section -->
  <section id="case-studies" class="py-10 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl text-center">Case Studies</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl text-center mt-2">{caseStudySection.dm_case_studies_headline}</p>
      <p class="text-center text-[var(--muted-color)] mt-4 max-w-2xl mx-auto">
        Selected performance marketing case studies from Google Ads, Meta Ads, and cross-channel paid media campaigns.
      </p>
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {caseStudies.map((cs) => {
          const images = cs.images as PortfolioMediaItem[];
          const videos = cs.videos as PortfolioVideoItem[];
          const hasVideo = videos.length > 0;

          return (
          <div class="rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] overflow-hidden flex flex-col">
            {images.length > 0 && (
              <button
                type="button"
                class="w-full cursor-pointer border-0 bg-transparent p-0 group"
                onclick={`openLightbox('${cs.id}', 0)`}
                aria-label={`View case study gallery: ${cs.title}`}
              >
                <div class="relative h-48 overflow-hidden">
                  <img
                    src={images[0].imageUrl}
                    alt={images[0].altText || `${cs.title} - campaign dashboard`}
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                    <span class="text-white text-sm font-semibold px-3 py-1.5 rounded-full border border-white/40">View {images.length} images</span>
                  </div>
                </div>
              </button>
            )}
              <div class="p-4 sm:p-5 flex flex-col gap-2 flex-grow">
                <h3 class="text-lg font-semibold text-[var(--foreground-color)]">{cs.title}</h3>
                <span class="text-xs font-medium text-sky uppercase">{cs.subtitle}</span>
                <p class="text-sm text-[var(--muted-color)] leading-relaxed">{cs.description}</p>
                {hasVideo && (
                  <button
                    type="button"
                    class="mt-2 inline-flex items-center justify-center rounded-md border border-sky px-3 py-2 text-sm font-semibold text-sky transition-colors hover:bg-sky hover:text-midnight"
                    onclick={`openVideoModal('${cs.id}')`}
                    aria-label={`Watch video for ${cs.title}`}
                  >
                    Watch Video
                  </button>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-10 md:py-16">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="font-heading text-accent font-normal uppercase text-lg md:text-xl">{contact.contact_subheadline}</h2>
      <p class="font-heading text-foreground font-semibold text-3xl md:text-4xl mt-2">{contact.contact_headline}</p>
      <p class="mt-4 text-[var(--muted-color)] leading-relaxed">
        {contact.contact_description}
      </p>
      <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3 sm:gap-4 mt-8">
        <a href={`mailto:${contact.contact_email}`} class="inline-flex items-center gap-2 rounded-md bg-sky text-midnight px-6 py-3 font-semibold hover:bg-sky/90 transition-colors">
          Email Me
        </a>
        <a href={contact.contact_linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-navy-border text-light-text px-6 py-3 hover:text-sky hover:border-sky transition-colors">
          LinkedIn
        </a>
        <a href={contact.contant_whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-navy-border text-light-text px-6 py-3 hover:text-sky hover:border-sky transition-colors">
          WhatsApp
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox Dialog -->
  <dialog id="gallery-dialog" class="fixed inset-0 z-50 bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm w-full h-full max-w-full max-h-full border-0 p-0 m-0">
    <div class="flex flex-col items-center justify-center w-full h-full relative" onclick="document.getElementById('gallery-dialog').close()">
      <img
        id="lightbox-img"
        src=""
        alt="Gallery image"
        class="max-w-[90vw] max-h-[80vh] object-contain rounded-lg"
        onclick="event.stopPropagation()"
      />
      <span id="lightbox-counter" class="text-white text-sm mt-4 font-medium"></span>
      <button type="button" class="absolute left-4 top-1/2 -translate-y-1/2 text-white bg-black/50 hover:bg-black/70 rounded-full p-3 transition-colors" onclick="event.stopPropagation(); prevImage()" aria-label="Previous image">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-white bg-black/50 hover:bg-black/70 rounded-full p-3 transition-colors" onclick="event.stopPropagation(); nextImage()" aria-label="Next image">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <button type="button" class="absolute top-4 right-4 text-white bg-black/50 hover:bg-black/70 rounded-full p-2 transition-colors" onclick="event.stopPropagation(); document.getElementById('gallery-dialog').close()" aria-label="Close gallery">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </dialog>

  <dialog id="video-dialog" class="fixed inset-0 z-50 bg-transparent backdrop:bg-black/85 backdrop:backdrop-blur-sm w-full h-full max-w-full max-h-full border-0 p-0 m-0">
    <div class="flex h-full w-full items-center justify-center p-4" onclick="closeVideoModal()">
      <div class="relative w-full max-w-4xl rounded-lg border border-[var(--border-color)] bg-[var(--surface-color)] p-4 shadow-2xl" onclick="event.stopPropagation()">
        <button type="button" class="absolute right-4 top-4 rounded-full border border-[var(--border-color)] px-3 py-2 text-sm text-[var(--muted-color)] hover:text-sky hover:border-sky transition-colors" onclick="closeVideoModal()" aria-label="Close video popup">
          Close
        </button>
        <video id="portfolio-video" class="w-full max-h-[75vh] rounded-md bg-black" controls playsinline></video>
      </div>
    </div>
  </dialog>

  <script is:inline>
    document.addEventListener('keydown', (e) => {
      const dialog = document.getElementById('gallery-dialog');
      if (!dialog || !dialog.open) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); prevImage(); }
      if (e.key === 'ArrowRight') { e.preventDefault(); nextImage(); }
      if (e.key === 'Escape') { e.preventDefault(); dialog.close(); }
    });

    document.getElementById('video-dialog')?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeVideoModal();
    });
  </script>

  <!-- Tab filtering -->
  <script is:inline>
    (function () {
      const tabs = document.getElementById('project-tabs');
      if (!tabs) return;

      tabs.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-filter]');
        if (!btn) return;

        const filter = btn.getAttribute('data-filter');

        // Update active tab styling
        tabs.querySelectorAll('[data-filter]').forEach(function (t) {
          if (t === btn) {
            t.className = 'rounded-full bg-sky text-midnight px-4 py-2 text-sm font-semibold cursor-pointer border-0';
          } else {
            t.className = 'rounded-full border border-[var(--border-color)] px-4 py-2 text-sm text-[var(--muted-color)] cursor-pointer bg-transparent hover:text-sky hover:border-sky transition-colors';
          }
        });

        // Filter cards (only those inside the projects section grid)
        const projectCards = document.querySelectorAll('#projects .grid > [data-filter]');
        projectCards.forEach(function (card) {
          const cardFilter = card.getAttribute('data-filter');
          if (filter === 'all' || cardFilter === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    })();
  </script>
</Layout>
